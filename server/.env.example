# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — include your cluster username and password.
# Get it from: Atlas dashboard → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/study-abroad?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Any long random string — used to sign JWTs. Never commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Your OpenAI API key — needs access to gpt-4o, gpt-4o-mini, text-embedding-3-small.
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Pinecone ─────────────────────────────────────────────────────────────────
# Create a free index at https://app.pinecone.io
# Index settings: name=study-abroad, dimensions=1536, metric=cosine, serverless AWS us-east-1
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=study-abroad

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Create a free Redis database at https://console.upstash.com
# Use the rediss:// URL (TLS) — NOT the redis-cli command.
# Optional locally — omit this and the server runs without caching (chat still works).
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# CORS origin for Socket.io — set to your Vercel URL in production.
# In local dev: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Set to "production" on Render — controls CORS and error verbosity.
# NODE_ENV=production
